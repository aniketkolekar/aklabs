{
  "name": "@aklabs/source",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": "20.18.1",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "check-vitest-compat": "node scripts/check-nx-vitest-compat.js",
    "build:all": "nx run-many -t build",
    "build:utils": "nx run-many -t build --projects=tag:type:utils",
    "test": "nx run-many -t test",
    "test:affected": "nx affected -t test",
    "lint": "nx run-many -t lint",
    "lint:affected": "nx affected -t lint",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "20.4.3",
    "@commitlint/config-conventional": "20.4.3",
    "@eslint/js": "9.39.3",
    "@nx/eslint": "22.5.4",
    "@nx/eslint-plugin": "22.5.4",
    "@nx/js": "22.5.4",
    "@nx/vite": "22.5.4",
    "@nx/workspace": "22.5.4",
    "@secretlint/secretlint-rule-preset-recommend": "11.3.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.18",
    "@swc/helpers": "0.5.18",
    "@types/node": "20.19.9",
    "@vitest/coverage-v8": "4.0.18",
    "@vitest/ui": "4.0.18",
    "eslint": "9.39.3",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-perfectionist": "5.6.0",
    "husky": "9.1.7",
    "jiti": "2.4.2",
    "jsdom": "22.1.0",
    "lint-staged": "16.1.0",
    "nx": "22.5.4",
    "prettier": "3.6.2",
    "secretlint": "11.3.1",
    "tslib": "2.8.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.56.1",
    "vite": "7.0.0",
    "vite-plugin-dts": "4.5.4",
    "vitest": "4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,scss}": [
      "prettier --write"
    ]
  }
}
